# Copy this file to ".env" in the project root and fill in what you have.
# EVERYTHING is optional -- the app works fully offline with zero keys.
# Adding a key just upgrades the quality of that one component.

# ---------------------------------------------------------------------------
# Hugging Face Cloud (Centralized AI Gateway)
# ---------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here
HF_GEMMA_MODEL=google/gemma-3-4b-it
HF_VOXCPM_MODEL=your_voxcpm_model
HF_PROVIDER=auto
HF_GEMMA_ENDPOINT=
HF_VOXCPM_ENDPOINT=

# ---------------------------------------------------------------------------
# Speech-to-text (Whisper) -- runs locally or via HF Cloud.
# Options: tiny, base, small, medium, large  (bigger = slower but more accurate)
# ---------------------------------------------------------------------------
WHISPER_MODEL_SIZE=medium

# ---------------------------------------------------------------------------
# Vision (describes what's on screen in each frame)
# Leave VISION_PROVIDER=auto to automatically use HF/Gemma/OpenAI/Anthropic if configured,
# otherwise it silently falls back to offline OCR.
# ---------------------------------------------------------------------------
VISION_PROVIDER=auto
VISION_MODEL=

# ---------------------------------------------------------------------------
# LLM (combines transcript + visual info, tutor, quiz, RAG, global assistant)
# "auto" uses Gemma via HF Cloud if HF_TOKEN is set, else fallbacks.
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
LLM_MODEL=

# ---------------------------------------------------------------------------
# Legacy API keys (optional fallback)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Text-to-speech. "auto" uses VoxCPM via HF if available, else pyttsx3
# ---------------------------------------------------------------------------
TTS_PROVIDER=auto

# ---------------------------------------------------------------------------
# Frame sampling
# ---------------------------------------------------------------------------
FRAME_INTERVAL_SECONDS=5
FRAME_MIN_INTERVAL=2.0
SCENE_CHANGE_THRESHOLD=5.0

# ===========================================================================
# Frontend — Production API Configuration
# ===========================================================================
# Public base URL of your deployed FastAPI backend.
# This is used by the Next.js frontend to make all processing API calls.
# IMPORTANT: Do NOT hardcode "localhost" in production.
# On a single-origin Fly.io deploy keep this as "/api" so the frontend calls
# the backend through the same domain (Caddy strips the /api prefix).
# Example: https://api.yourdomain.com   or   /api  (single-origin Fly deploy)
NEXT_PUBLIC_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Demo Mode — Controlled testing / Hackathon demos ONLY
# ---------------------------------------------------------------------------
# Uncomment to enable offline demo fixtures and allow DEMO_python_loops
# benchmark data to be served when the backend is unavailable.
#
# NEVER set this on a public production website.
# Normal production users should never see demo data automatically.
#
# You can also enable demo mode per-browser in developer tools via:
#   localStorage.setItem("eduaccess:dev:demo-mode", "1")
#
# NEXT_PUBLIC_ENABLE_DEMO_MODE=1

# ===========================================================================
# Backend CORS Origins — Production
# ===========================================================================
# Comma-separated list of origins allowed to call the FastAPI backend.
# For PUBLIC PRODUCTION deployment, set this to your exact Vercel domain.
#
# PRODUCTION — DO NOT use "*" in production!
# Example:
# CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
#
# Multiple origins example:
# CORS_ORIGINS=https://eduaccess.vercel.app,https://studio.eduaccess.ai
#
# DEVELOPMENT ONLY (insecure):
# CORS_ORIGINS=*
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app

