.git
.gitignore
.gitattributes
**/__pycache__/
**/*.pyc
.venv/
venv/
.env
.env.*.local
**/node_modules/
**/.next/
frontend/next-app/out/
**/qa_screenshots*/
scratch/
*.log

# Keep only DEMO fixtures (mirrors .gitignore policy)
data/audio/*
!data/audio/.gitkeep
data/frames/*
!data/frames/.gitkeep
!data/frames/DEMO_python_loops/
!data/frames/DEMO_python_loops/**
data/inference_cache/*
data/temp/*
data/videos/*
!data/videos/.gitkeep
!data/videos/DEMO_python_loops.mp4
data/outputs/*
!data/outputs/.gitkeep
!data/outputs/DEMO_*
data/jobs/*
!data/jobs/.gitkeep
!data/jobs/DEMO_python_loops.json