# Caddy reverse proxy for EduAccess AI single-origin deployment.
# Fly edge terminates TLS; Caddy listens plain on :8080.
# - /api/*  -> FastAPI backend (prefix STRIPPED)
#   The frontend calls the backend via same-origin /api/* (NEXT_PUBLIC_API_BASE_URL=/api),
#   including /api/files/videos, /api/files/outputs, /api/files/narration -> backend /files/*
# - everything else -> Next.js standalone server
{
	admin off
}

:8080 {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		encode gzip zstd
		reverse_proxy 127.0.0.1:3000
	}
}